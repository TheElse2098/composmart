RewriteEngine On

# Page d'erreur 404 personnalisée (au lieu de l'erreur Apache brute).
ErrorDocument 404 /404.html

# Pages, scripts et styles : le navigateur redemande à chaque fois au serveur
# si le fichier a changé (réponse 304, sans corps, quand ce n'est pas le cas).
# Sans cet en-tête il décide seul de la durée de garde, et peut servir un
# module d'avant le déploiement à côté d'un module d'après : une page faite
# de plusieurs fichiers qui s'importent ne le supporte pas. C'est aussi ce qui
# rend inutile l'ancienne convention « ?v=N » sur les scripts.
# <IfModule> : si le module headers manquait à l'image, cette règle serait
# ignorée au lieu de mettre tout le site en erreur 500.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Derrière le proxy TLS (Traefik/k3s), Apache ne voit que du HTTP : les
# redirections doivent reprendre le schéma d'origine du client
# (X-Forwarded-Proto), sinon Location: http://... → mixed content en HTTPS.

# /index et /index.html → redirect vers /
RewriteCond %{HTTP:X-Forwarded-Proto} =https
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index(\.html)?(\s|\ ) [NC]
RewriteRule ^ https://%{HTTP_HOST}/ [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index(\.html)?(\s|\ ) [NC]
RewriteRule ^ / [R=301,L]

# /carte.html → redirect vers /carte (propre dans l'URL bar)
RewriteCond %{HTTP:X-Forwarded-Proto} =https
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.+)\.html\ HTTP/
RewriteRule ^ https://%{HTTP_HOST}/%1 [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.+)\.html\ HTTP/
RewriteRule ^ /%1 [R=301,L]

# /parcours : ancienne adresse de la page de compte. Redirection permanente
# plutôt qu'une page qui renvoie par script (supprimée le 16/11/2026).
RewriteCond %{HTTP:X-Forwarded-Proto} =https
RewriteRule ^parcours$ https://%{HTTP_HOST}/compte [R=301,L]
RewriteRule ^parcours$ /compte [R=301,L]

# /cours/{slug} → cours-detail.html (avant la règle générale)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^cours/([^./]+)$ cours-detail.html [L]

# /carte → sert carte.html en interne (seulement si le .html existe,
# sinon on laisse Apache renvoyer un 404 → ErrorDocument /404.html)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^.]+)$ $1.html [L]
