# Racine de evenements-api (déployé en /var/www/html/.htaccess).
#
# Les pages /evenements-admin ne sont pas des fichiers : elles passent par le
# contrôleur, qui vérifie isAdmin via auth-api avant de servir quoi que ce soit
# (cf. courses-api/htaccess-racine, même principe). Les gabarits vivent hors
# de la racine web (/var/www/evenements-admin-vues/).
#
# Le motif ne touche pas /api/evenements/... : la règle porte sur le chemin
# sans barre initiale, et « api/evenements/admin.php » ne commence pas par
# « evenements-admin ».
RewriteEngine On
# Tout ce qui COMMENCE par « evenements-admin » va au contrôleur, et pas seulement
# « evenements-admin » ou « evenements-admin/… » : l'Ingress (Traefik) envoie ici toute adresse
# qui commence par ce préfixe, « /evenements-adminxyz » compris. Sans ça, une telle
# adresse tombait sur le 404 brut d'Apache au lieu de celui du site, et se
# distinguait d'une adresse inexistante. Le contrôleur n'accepte que
# « /evenements-admin » et « /evenements-admin/… » ; le reste est sa 404 habituelle.
# La condition évite de réécrire le contrôleur sur lui-même.
RewriteCond %{REQUEST_URI} !^/evenements-admin-controleur\.php$
RewriteRule ^evenements-admin /evenements-admin-controleur.php [L,QSA]
