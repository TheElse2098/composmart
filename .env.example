DB_HOST=db
DB_NAME=Composmart
DB_USER=composmart
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme_root

# Sessions + rate-limit partagés (vide = repli sur sessions/rate-limit fichier)
REDIS_HOST=redis
REDIS_PORT=6379

# Secret partagé pour l'audit inter-services (map-api → auth-api). À changer en prod.
AUDIT_SECRET=changeme_audit_secret

# SMTP pour les notifications mail (signalements carte, formulaire contact).
# Exemple OVH : ssl0.ovh.net, port 465 + SMTP_SECURE=ssl (ou 587 + tls).
# Laisser SMTP_HOST vide désactive l'envoi (aucun mail n'est tenté).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=contact@composmart.fr
SMTP_PASSWORD=
MAIL_FROM=contact@composmart.fr

# Image pour la prod (docker-compose.prod.yml)
# WEB_IMAGE=ghcr.io/theelse2098/composmart/web:latest
